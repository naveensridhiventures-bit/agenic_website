{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" },
    { "source": "/agenic-admin", "destination": "/api/index.js" },
    { "source": "/p/:id", "destination": "/product" }
  ],
  "functions": { "api/index.js": { "includeFiles": "{public,views}/**" } }
}
